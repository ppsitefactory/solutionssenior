# ============================================================
# REDIRECTIONS 301 — Pages villes (recentrage geographique)
# Mise en place : 2026-06-24
#
# Toutes les anciennes pages villes redirigent vers le hub
# /monte-escaliers/. Quand une ville est recreee (PACA), retirer
# sa ligne ci-dessous.
#
# NB : le HTTPS et le www sont geres par Hostinger (hPanel),
# pas ici. Ce fichier ne contient que les redirections de pages.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# --- Villes hors PACA (zones non couvertes pour l'instant) ---
Redirect 301 /monte-escaliers/amiens/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/angers/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/bordeaux/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/brest/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/clermont-ferrand/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/dijon/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/grenoble/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/le-havre/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/lille/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/limoges/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/lyon/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/metz/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/montpellier/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/nantes/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/nimes/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/perpignan/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/reims/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/rennes/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/saint-etienne/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/strasbourg/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/toulouse/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/tours/ https://solutionssenior.fr/monte-escaliers/

# --- Villes PACA (a recreer en version unique : retirer la ligne ---
# --- correspondante le jour ou la vraie page ville est publiee) ---
Redirect 301 /monte-escaliers/aix-en-provence/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/marseille/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/nice/ https://solutionssenior.fr/monte-escaliers/
Redirect 301 /monte-escaliers/toulon/ https://solutionssenior.fr/monte-escaliers/

# --- Fin des redirections villes ---
