# ============================================================
# CONFIGURATION .htaccess - solutionssenior.fr
# ============================================================
# NB : le HTTPS et le www sont geres par Hostinger (hPanel).

# --- Page d'erreur 404 personnalisee ---
ErrorDocument 404 /404.html

# ============================================================
# REDIRECTIONS 301 - Pages villes (recentrage geographique)
# Mise en place : 2026-06-24 / cible MAJ : 2026-06-27
# Les villes hors PACA sont redirigees vers la page de mise en
# relation /monte-escaliers/installateurs/ (intention coherente).
# Quand une ville PACA est recreee, retirer sa ligne ci-dessous.
# On utilise RewriteRule [R=301,L] et non Redirect, car le dossier
# physique de la ville existe encore (index.html present).
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Villes hors PACA ---
  RewriteRule ^monte-escaliers/amiens/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/angers/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/bordeaux/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/brest/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/clermont-ferrand/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/dijon/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/grenoble/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/le-havre/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/lille/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/limoges/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/lyon/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/metz/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/montpellier/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/nantes/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/nimes/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/perpignan/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/reims/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/rennes/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/saint-etienne/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/strasbourg/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/toulouse/?$ /monte-escaliers/installateurs/ [R=301,L]
  RewriteRule ^monte-escaliers/tours/?$ /monte-escaliers/installateurs/ [R=301,L]

</IfModule>
