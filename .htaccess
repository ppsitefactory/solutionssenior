# ============================================================
# REDIRECTIONS 301 - Pages villes (recentrage geographique)
# Mise en place : 2026-06-24
#
# Toutes les anciennes pages villes redirigent vers le hub
# /monte-escaliers/. Quand une ville est recreee (PACA), retirer
# son bloc RewriteRule ci-dessous.
#
# NB 1 : le HTTPS et le www sont geres par Hostinger (hPanel).
# NB 2 : on utilise RewriteRule [R=301,L] et non Redirect, car le
# dossier physique de la ville existe encore (index.html present).
# RewriteRule force la redirection meme si le fichier existe.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Villes hors PACA ---
  RewriteRule ^monte-escaliers/amiens/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/angers/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/bordeaux/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/brest/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/clermont-ferrand/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/dijon/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/grenoble/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/le-havre/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/lille/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/limoges/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/lyon/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/metz/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/montpellier/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/nantes/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/nimes/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/perpignan/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/reims/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/rennes/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/saint-etienne/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/strasbourg/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/toulouse/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/tours/?$ /monte-escaliers/ [R=301,L]

  # --- Villes PACA (retirer le bloc quand la vraie page est publiee) ---
  RewriteRule ^monte-escaliers/aix-en-provence/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/marseille/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/nice/?$ /monte-escaliers/ [R=301,L]
  RewriteRule ^monte-escaliers/toulon/?$ /monte-escaliers/ [R=301,L]

</IfModule>
